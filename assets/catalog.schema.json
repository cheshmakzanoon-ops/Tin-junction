{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cheshmakzanoon-ops/Tin-junction/assets/catalog.schema.json",
  "title": "Tin Junction asset catalog",
  "description": "Structural inventory only. Approval also requires semantic file/hash/licence checks and actual visual/runtime evidence. Empty is permitted for setup, not for release packaging.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "$ref": "#/$defs/version" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "description": "Repository-relative path; semantic validation must additionally enforce approved roots, no symlink escape and real file existence."
    },
    "vector3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "mediaType"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 3 },
        "storage": { "enum": ["git", "git-lfs", "controlled-store"] },
        "retrievalRecord": { "$ref": "#/$defs/repoPath" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "storage": { "const": "controlled-store" } },
            "required": ["storage"]
          },
          "then": { "required": ["retrievalRecord"] }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "origin", "license", "rightsRecord", "redistributionAllowed", "derivativeWorksAllowed", "sourceUrls", "status"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["original", "licensed", "public-domain"] },
        "license": { "type": "string", "minLength": 1 },
        "rightsRecord": { "$ref": "#/$defs/repoPath" },
        "redistributionAllowed": { "type": "boolean" },
        "derivativeWorksAllowed": { "type": "boolean" },
        "sourceUrls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "uniqueItems": true
        },
        "status": { "enum": ["pending", "verified", "rejected"] },
        "verifiedAt": { "type": "string", "format": "date" },
        "verifiedBy": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string" },
        "restrictions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } } },
          "then": { "required": ["verifiedAt", "verifiedBy"] }
        }
      ]
    },
    "socket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nodePath", "positionMeters", "purpose"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nodePath": { "type": "string", "minLength": 1 },
        "positionMeters": { "$ref": "#/$defs/vector3" },
        "purpose": { "type": "string", "minLength": 1 },
        "forward": { "$ref": "#/$defs/vector3" },
        "up": { "$ref": "#/$defs/vector3" }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "upAxis", "forwardAxis", "modelScaleRatio", "boundsMinMeters", "boundsMaxMeters", "rootPivotMeters", "sockets"],
      "properties": {
        "units": { "const": "physical-model-meters" },
        "upAxis": { "const": "+Y" },
        "forwardAxis": { "const": "+Z" },
        "modelScaleRatio": { "type": "number", "exclusiveMinimum": 0 },
        "boundsMinMeters": { "$ref": "#/$defs/vector3" },
        "boundsMaxMeters": { "$ref": "#/$defs/vector3" },
        "rootPivotMeters": { "$ref": "#/$defs/vector3" },
        "sockets": { "type": "array", "items": { "$ref": "#/$defs/socket" } },
        "referenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "lod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "runtimePath", "triangles", "materialCount", "drawCallsEstimate"],
      "properties": {
        "level": { "type": "integer", "minimum": 0 },
        "runtimePath": { "$ref": "#/$defs/repoPath" },
        "triangles": { "type": "integer", "minimum": 0 },
        "materialCount": { "type": "integer", "minimum": 0 },
        "drawCallsEstimate": { "type": "integer", "minimum": 0 },
        "policyRecord": { "$ref": "#/$defs/repoPath" }
      }
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtimePath", "width", "height", "semantic", "colorSpace", "mipLevels", "residentBytesEstimate"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "runtimePath": { "$ref": "#/$defs/repoPath" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "semantic": { "enum": ["base-color", "emissive", "normal", "metallic-roughness", "occlusion", "packed-mask", "environment", "lightmap", "other"] },
        "colorSpace": { "enum": ["srgb", "linear-srgb", "non-color"] },
        "mipLevels": { "type": "integer", "minimum": 1 },
        "residentBytesEstimate": { "type": "integer", "minimum": 0 },
        "compression": { "type": "string", "minLength": 1 },
        "channelLayout": { "type": "string", "minLength": 1 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "role", "date", "outcome", "evidence"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "role": { "enum": ["rights", "technical", "art", "interaction", "device", "owner"] },
        "date": { "type": "string", "format": "date" },
        "outcome": { "enum": ["approved", "rejected", "changes-required"] },
        "evidence": { "$ref": "#/$defs/repoPath" },
        "notes": { "type": "string" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical", "visual", "device", "provisionalBudgets", "evidence", "openDefects"],
      "properties": {
        "technical": { "enum": ["not_run", "pass", "fail", "blocked"] },
        "visual": { "enum": ["not_run", "pass", "fail", "blocked"] },
        "device": { "enum": ["not_run", "pass", "fail", "blocked"] },
        "provisionalBudgets": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/repoPath" }, "uniqueItems": true },
        "openDefects": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "version", "stage", "taskId", "provenance", "sourceFiles", "runtimeFiles", "requiredExtensions", "quality", "approvals"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["locomotive", "rolling-stock", "track", "scenery", "case", "material", "texture", "environment", "audio", "reference", "fixture"] },
        "version": { "$ref": "#/$defs/version" },
        "stage": { "enum": ["planned", "prototype", "review", "approved", "retired"] },
        "taskId": { "type": "string", "pattern": "^P[0-9]{2}-T[0-9]{2}$" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "sourceFiles": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "runtimeFiles": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "requiredExtensions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "design": { "$ref": "#/$defs/design" },
        "lods": { "type": "array", "items": { "$ref": "#/$defs/lod" } },
        "textures": { "type": "array", "items": { "$ref": "#/$defs/texture" } },
        "collisionRecord": { "$ref": "#/$defs/repoPath" },
        "animationRecord": { "$ref": "#/$defs/repoPath" },
        "exportRecord": { "$ref": "#/$defs/repoPath" },
        "compatibilityRecord": { "$ref": "#/$defs/repoPath" },
        "quality": { "$ref": "#/$defs/quality" },
        "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "stage": { "const": "approved" } } },
          "then": {
            "required": ["exportRecord"],
            "properties": {
              "sourceFiles": { "minItems": 1 },
              "runtimeFiles": { "minItems": 1 },
              "approvals": {
                "minItems": 4,
                "allOf": [
                  { "contains": { "properties": { "role": { "const": "rights" }, "outcome": { "const": "approved" } }, "required": ["role", "outcome"] } },
                  { "contains": { "properties": { "role": { "const": "technical" }, "outcome": { "const": "approved" } }, "required": ["role", "outcome"] } },
                  { "contains": { "properties": { "role": { "const": "art" }, "outcome": { "const": "approved" } }, "required": ["role", "outcome"] } },
                  { "contains": { "properties": { "role": { "const": "device" }, "outcome": { "const": "approved" } }, "required": ["role", "outcome"] } }
                ]
              },
              "provenance": {
                "properties": {
                  "status": { "const": "verified" },
                  "redistributionAllowed": { "const": true }
                }
              },
              "quality": {
                "properties": {
                  "technical": { "const": "pass" },
                  "visual": { "const": "pass" },
                  "device": { "const": "pass" },
                  "provisionalBudgets": { "const": false },
                  "evidence": { "minItems": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": { "enum": ["review", "approved"] },
              "kind": { "enum": ["locomotive", "rolling-stock", "track", "scenery", "case"] }
            }
          },
          "then": {
            "required": ["design", "lods", "collisionRecord"],
            "properties": { "lods": { "minItems": 1 } }
          }
        }
      ]
    }
  }
}
